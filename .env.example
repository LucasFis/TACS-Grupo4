# MongoDB
# Credenciales del contenedor Mongo
MONGO_USER=root
MONGO_PASSWORD=root
MONGO_DB=tacs

# URI completa — por defecto apunta al servicio mongodb del compose (sin auth en dev)
MONGO_URI=mongodb://mongodb:27017/tacs

MONGO_REPLICA_SET_NAME=rs0

# Spring Boot
SPRING_PROFILE=mongodb
SEED_DATA=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Hot Reload
VITE_POLL=true
CHOKIDAR_USEPOLLING=true

#Token JWT
JWT_SECRET=secreto-super-largo-que-es-muy-seguro-y-no-rompe
JWT_EXPIRATION=12h

# Observabilidad (OpenTelemetry -> Grafana Cloud)
# OTEL_EXPORTER_OTLP_ENDPOINT y OTEL_EXPORTER_OTLP_HEADERS son secrets.
# Si quedan vacios, la app NO exporta telemetria (util para dev local sin gastar cuota).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
#
# Separacion por ambiente: lo unico que cambia entre local/staging/produccion es
# deployment.environment.name (y service.version, idealmente el git SHA del deploy).
# OTEL_SERVICE_NAME se mantiene "tacs-backend" en los tres para poder comparar lado a lado.
#   local      -> deployment.environment.name=local
#   staging    -> deployment.environment.name=staging      (config en Render / render.yaml)
#   produccion -> deployment.environment.name=production    (config en Render / render.yaml)
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.version=dev

#Telegram
TELEGRAM_BOT_TOKEN=tokendementira:tokenmentiroso
TELEGRAM_BOT_USERNAME=nombredelbot
